{
    "name": "@sandlada/mcu-helper",
    "version": "1.0.0-nightly.20260711.a",
    "author": "Kai-Orion & Sandlada",
    "license": "MIT",
    "type": "module",
    "description": "Generate Material Design 3 color tokens, palettes, and CSS custom properties from a source color using @material/material-color-utilities.",
    "keywords": [
        "color",
        "theme-generator",
        "material",
        "material-design",
        "material-you",
        "material-tokens",
        "tokens",
        "design-tokens",
        "css",
        "css-custom-properties",
        "custom-properties",
        "color-tokens",
        "color-palette",
        "dynamic-color",
        "material-color-utilities",
        "mcu"
    ],
    "homepage": "https://github.com/sandlada/mcu-helper#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sandlada/mcu-helper.git"
    },
    "bugs": {
        "url": "https://github.com/sandlada/mcu-helper/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "main": "build/index.js",
    "module": "build/index.js",
    "files": [
        "build/**/*",
        "README.md"
    ],
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "import": "./build/index.js",
            "require": "./build/index.js",
            "default": "./build/index.js"
        },
        "./*": {
            "types": "./build/*.d.ts",
            "import": "./build/*.js",
            "require": "./build/*.js",
            "default": "./build/*.js"
        }
    },
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "compile": "rolldown --config rolldown.config.mjs && tsc --emitDeclarationOnly",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@material/material-color-utilities": "^0.4.0",
        "@types/node": "26.1.1",
        "rolldown": "^1.2.0",
        "typescript": "~7.0.2",
        "vitest": "^4.1.10"
    },
    "peerDependencies": {
        "@material/material-color-utilities": "^0.4.0"
    },
    "workspaces": [
        "dev-app"
    ]
}
